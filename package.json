{
  "type": "module",
  "license": "Apache-2.0",
  "name": "@sovereignbase/actor-channel",
  "version": "1.6.0",
  "description": "Bidirectional actor channels with pub/sub, peer relaying, and RPC.",
  "keywords": [
    "actor-model",
    "rpc",
    "websocket",
    "pubsub",
    "realtime",
    "message-broker",
    "typescript",
    "sovereignbase"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "format": "prettier . --write",
    "build": "npm run build:package && npm run build:docs",
    "build:package": "tsdown",
    "build:docs": "typedoc",
    "test": "npm run build && npm run typecheck && node scripts/run-tests.ts all",
    "typecheck": "tsc --noEmit && tsc --noEmit --project test/tsconfig.json",
    "test:vitest": "node scripts/run-tests.ts coverage",
    "test:e2e": "node scripts/run-tests.ts e2e",
    "test:e2e:browsers": "node scripts/run-tests.ts browsers",
    "test:e2e:runtimes": "node scripts/run-tests.ts runtimes",
    "test:e2e:node": "node scripts/run-tests.ts node",
    "test:e2e:bun": "node scripts/run-tests.ts bun",
    "test:e2e:deno": "node scripts/run-tests.ts deno",
    "test:e2e:edge": "node scripts/run-tests.ts edge",
    "test:e2e:cloudflare": "node scripts/run-tests.ts cloudflare",
    "prepare": "husky",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@typescript/lib-dom": "npm:modern-web-types@^0.8.0",
    "@vitest/coverage-v8": "^5.0.5",
    "edge-runtime": "^4.0.1",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.4",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0",
    "ws": "^8.22.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignbase/actor-channel.git"
  },
  "bugs": {
    "url": "https://github.com/sovereignbase/actor-channel/issues"
  },
  "homepage": "https://sovereignbase.dev/actor-channel",
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
