{
  "type": "module",
  "license": "Apache-2.0",
  "name": "@sovereignbase/actor-channel",
  "version": "0.0.0",
  "description": "Bidirectional actor channels with pub/sub, peer relaying, and RPC.",
  "keywords": [
    "actor-model",
    "rpc",
    "websocket",
    "pubsub",
    "realtime",
    "message-broker",
    "typescript",
    "sovereignbase"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "format": "prettier . --write",
    "build": "npm run build:package && npm run build:docs",
    "build:package": "tsdown",
    "build:docs": "typedoc",
    "test": "npm run build && npm run typecheck && npm run test:vitest && npm run test:e2e",
    "typecheck": "tsc --noEmit --project test/tsconfig.json",
    "test:vitest": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sovereignbase/actor-channel.git"
  },
  "bugs": {
    "url": "https://github.com/sovereignbase/actor-channel/issues"
  },
  "homepage": "https://sovereignbase.dev/actor-channel",
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3"
  }
}
